FROM python:3.12-slim
WORKDIR /app
COPY requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt
RUN useradd --system --uid 10001 --create-home gatherly && mkdir /data && chown gatherly /data
COPY gatherly/ gatherly/
ENV OMP_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false HF_HOME=/home/gatherly/.cache/huggingface
USER gatherly
RUN python -c "from sentence_transformers import SentenceTransformer; from gatherly.recommendations import MODEL,REVISION; SentenceTransformer(MODEL,revision=REVISION,device='cpu',trust_remote_code=False)"
ENV HF_HUB_OFFLINE=1
VOLUME ["/data"]
CMD ["python", "-m", "gatherly.worker"]
