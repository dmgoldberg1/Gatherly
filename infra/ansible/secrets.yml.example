# Copy to secrets.yml (gitignored), chmod 600. Generate each secret with openssl rand -hex 32.
gatherly_image: ghcr.io/your-account/gatherly:sha-COMMIT
postgres_password: REPLACE_WITH_64_HEX_CHARACTERS
auth_secret: REPLACE_WITH_64_HEX_CHARACTERS
grafana_admin_password: REPLACE_WITH_64_HEX_CHARACTERS
# First deployment can load an image built locally instead of GHCR:
# image_archive: /absolute/path/gatherly.tar
# gatherly_image: gatherly:demo-COMMIT
# Enable after the domain points to Terraform's public_ip:
# domain: meet-greet.203.0.113.10.sslip.io
# letsencrypt_email: "" # optional
# enable_https: true

# Required for recommendations: registry image or local worker archive.
gatherly_worker_image: gatherly-worker:demo
worker_image_archive: ""
